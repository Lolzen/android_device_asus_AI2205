# IZat configuration for SM8550
# Copyright (C) 2024 OmniROM Project

[PROCESS_NAME]
PROCESS_NAME=lowi-server
PROCESS_ARGUMENT=
PROCESS_STATE=ENABLED
PROCESS_GROUPS=gps wifi inet oem_2901
PREMIUM_FEATURE=0
IZAT_FEATURE_MASK=0xf303
PLATFORMS=all

[PROCESS_NAME]
PROCESS_NAME=xtwifi-client
PROCESS_ARGUMENT=
PROCESS_STATE=ENABLED
PROCESS_GROUPS=wifi inet gps system oem_2904
PREMIUM_FEATURE=1
IZAT_FEATURE_MASK=0xf0f
PLATFORMS=all

[PROCESS_NAME]
PROCESS_NAME=slim_daemon
PROCESS_ARGUMENT=
PROCESS_STATE=ENABLED
PROCESS_GROUPS=gps oem_2901 inet
PREMIUM_FEATURE=1
IZAT_FEATURE_MASK=0xf0
PLATFORMS=all

# OSNLP settings
OSNLP_PACKAGE=com.google.android.gms
OSNLP_PACKAGE_PREV=com.google.android.gms
OSNLP_ACTION=com.android.location.service.v3.NetworkLocationProvider
OSNLP_CUSTOM_PACKAGE=com.qualcomm.location
OSNLP_CUSTOM_ACTION=com.qualcomm.location.service.LocationService

# Latitude/Longitude settings
LATITUDE_THRESHOLD=100
LONGITUDE_THRESHOLD=100

# GTP_MODE settings
GTP_MODE=DISABLED
GTP_MODE_TIMER=10