# WiFi Configuration for SM8550

# Enable/Disable IMPS
gEnableImps=1

# Enable/Disable BMPS
gEnableBmps=1

# Phy Mode
gDot11Mode=0

# Assigned MAC Addresses
Intf0MacAddress=000AF58989FF
Intf1MacAddress=000AF58989FE
Intf2MacAddress=000AF58989FD
Intf3MacAddress=000AF58989FC

# UAPSD service interval
InfraUapsdVoSrvIntv=0
InfraUapsdViSrvIntv=0
InfraUapsdBeSrvIntv=0
InfraUapsdBkSrvIntv=0

# Flag to allow STA send AddTspec
gAddTSWhenACMIsOff=1

# Beacon filtering
gEnableBeaconFilter=1

# 802.11d support
g11dSupportEnabled=0

# 802.11h support
g11hSupportEnabled=1

# DFS Master mode
gEnableDFSMasterCap=1

# ESE Support
EseEnabled=0

# Fragmentation
gFragmentationThreshold=2346

# RSN Support
RSNAuthType=6

# Roaming support
gRoamingTime=0
gEnableRoamingOnGO=1

# Heartbeat threshold
HeartbeatThresh24=40

# Qpower support
gEnableQpower=1
gEnablePowerSaveOffload=1

# Enable logp
gEnableLogp=1

# NAT Keepalive
gStaKeepAlivePeriod=30

# ASSOC related
gReportMaxLinkSpeed=2

# P2P config
gEnableP2pListenOffload=1
gGoKeepAlivePeriod=30
gGoLinkMonitorPeriod=10

# WiFi Aware
gEnableNanSupport=1

# SAP config  
gEnableApProt=1
gApProtection=0xBFFF
gEnableApUapsd=1
gFixedRate=0
gSoftApMaxPeers=8

# SAP Country code
gAPCntryCode=000

# 802.11K support
gRrmEnable=1
gRrmOperChanMax=8
gRrmNonOperChanMax=8

# Scan related
gEnableIdleScan=0
gIdleScanTime=10000
gActiveMaxChannelTime=40
gActiveMinChannelTime=20

# Power saving related
gEnableSuspend=3
gMCAddrListEnable=1
gActiveModeOffload=1
gEnableActiveModeOffload=1
gMaxLIModulatedDTIM=3
gMaxLIModulatedDTIMMS=10000

# Thermal mitigation
gThermalMitigationEnable=0

# WOW Support
gWowEnable=1

# TCP/IP offload
gEnableIPChecksumOffload=1
hostArpOffload=1
hostNSOffload=1

# 11AC support
gVhtAmpduLenExponent=7
gVhtMpduLen=2
gMaxAmsduSizeRx=1
gVhtRxMCS=2
gVhtTxMCS=2
gTxBFEnable=1
gEnableTxBFeeSAP=1

# 11AX support
he_caps_6ghz=8bffffff7b1c0000feff7b1c00000000ff00
oce_sta_enable=1
oce_sap_enable=1
enable_11ax_obss_narrow_bw_rup=1
cfr_capture=1
cfr_enable=1
he_dynamic_frag_support=3
enable_ul_ofdma=1
enable_ul_mimo=1

# WPA3 support
sae_enabled=1
gcmp_enabled=1

# Spectral Scan
gEnableSpectralScan=1

# Channel Bonding
gChannelBondingMode24GHz=0
gChannelBondingMode5GHz=1
gChannelBondingMode6GHz=1

# Enable MAC Spoofing
gEnableMacAddrSpoof=2

# Enable Beacon Reception Stats
gEnableBeaconRxStats=1

# Set max wake lock timeout
max_wake_lock_duration=18000000

# WLM latency Enable
wlm_latency_enable=1

# Enable ETSI SRD channels
etsi_srd_chan_in_master_mode=3

# Enable 6GHz support
enable_6ghz_band=1

# MLO support
mlo_support_link_num=2
mlo_max_simultaneous_links=2

# QMI WWAN enable
qmi_wwan_enable=1

# END
END