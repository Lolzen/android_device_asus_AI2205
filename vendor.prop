# The stock vendor build.prop is not installed with the blobs, the
# properties required by the stock vendor services are listed here.
# Refresh them from a stock dump with tools/generate-from-dump.py.

# Graphics
ro.hardware.egl=adreno
ro.hardware.vulkan=adreno
ro.opengles.version=196610

# SoC
ro.soc.manufacturer=QTI
ro.soc.model=SM8550

# USB
vendor.usb.controller=a600000.dwc3

# Telephony
persist.radio.multisim.config=dsds
ro.telephony.sim_slots.count=2
